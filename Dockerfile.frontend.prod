FROM node:24-slim AS build

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

ARG NEXUS_API_BASE_URL=""
ARG NEXUS_SENTRY_DSN=""
ARG NEXUS_SENTRY_ENVIRONMENT="production"
ARG NEXUS_SENTRY_RELEASE=""
ARG NEXUS_SENTRY_TRACES_SAMPLE_RATE="0"

ENV NEXUS_API_BASE_URL=${NEXUS_API_BASE_URL} \
    NEXUS_SENTRY_DSN=${NEXUS_SENTRY_DSN} \
    NEXUS_SENTRY_ENVIRONMENT=${NEXUS_SENTRY_ENVIRONMENT} \
    NEXUS_SENTRY_RELEASE=${NEXUS_SENTRY_RELEASE} \
    NEXUS_SENTRY_TRACES_SAMPLE_RATE=${NEXUS_SENTRY_TRACES_SAMPLE_RATE}

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/runtime-config.sh /docker-entrypoint.d/99-nexus-runtime-config.sh
COPY --from=build /app/frontend/dist/frontend/browser /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.d/99-nexus-runtime-config.sh

EXPOSE 80

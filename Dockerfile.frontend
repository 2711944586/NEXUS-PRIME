FROM node:24-slim

ENV NEXUS_RUNTIME_CONFIG_LOCAL=1 \
    NEXUS_LOCAL_API_BASE_URL=http://127.0.0.1:5000/api/v1

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

EXPOSE 4200

CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "4200", "--allowed-hosts", "all"]

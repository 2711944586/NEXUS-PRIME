# NEXUS Prime local Docker Compose example
# Copy to .env only when you need to override local compose defaults.

POSTGRES_DB=nexus_prime
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=5000
FRONTEND_PORT=4200

SECRET_KEY=change-this-dev-secret
DATABASE_URL=postgresql+psycopg2://nexus:nexus@postgres:5432/nexus_prime
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

FRONTEND_ORIGIN=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
NEXUS_API_BASE_URL=http://127.0.0.1:5000/api/v1

AI_LOCAL_ANALYSIS=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_RAG_CONTEXT_LIMIT=4
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_MODEL=local-hash-v1
AI_EMBEDDING_DIMENSIONS=32
AI_EMBEDDING_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
OTEL_TRACES_ENABLED=false
OTEL_SERVICE_NAME=nexus-prime-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

NEXUS_SENTRY_DSN=
NEXUS_SENTRY_ENVIRONMENT=local
NEXUS_SENTRY_RELEASE=
NEXUS_SENTRY_TRACES_SAMPLE_RATE=0

# NEXUS Prime mainland China separated deployment example.
# Copy to .env.mainland and replace every secret before docker compose usage.

POSTGRES_DB=nexus_prime
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-strong-postgres-password

BACKEND_PORT=5000
FRONTEND_HTTP_PORT=8080

SECRET_KEY=replace-with-64-byte-random-secret
DATABASE_URL=postgresql+psycopg2://nexus:replace-with-strong-postgres-password@postgres:5432/nexus_prime
DB_SSL_MODE=prefer
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

FRONTEND_ORIGIN=https://erp.example.cn
CORS_ORIGINS=https://erp.example.cn
NEXUS_API_BASE_URL=https://api.example.cn/api/v1
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=None
JWT_EXPIRES_HOURS=12
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

AI_LOCAL_ANALYSIS=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_SECONDS=20
AI_CONNECT_TIMEOUT_SECONDS=5
AI_RAG_CONTEXT_LIMIT=4
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_MODEL=local-hash-v1
AI_EMBEDDING_DIMENSIONS=32
AI_EMBEDDING_TIMEOUT_SECONDS=20

USE_CLOUD_STORAGE=auto
REQUIRE_CLOUD_STORAGE_FOR_UPLOADS=auto
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# For Aliyun OSS / Tencent COS / Huawei OBS, keep credentials in backend only.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_SECRET=
PUBLIC_ASSET_CDN_ORIGIN=https://cdn.example.cn

LOG_LEVEL=INFO
OTEL_TRACES_ENABLED=false
OTEL_SERVICE_NAME=nexus-prime-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

NEXUS_SENTRY_DSN=
NEXUS_SENTRY_ENVIRONMENT=production-cn
NEXUS_SENTRY_RELEASE=
NEXUS_SENTRY_TRACES_SAMPLE_RATE=0

WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=120
WEB_MAX_REQUESTS=1000
WEB_MAX_REQUESTS_JITTER=100

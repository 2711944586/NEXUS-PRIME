# NEXUS Prime environment example
# Copy to .env and replace placeholders before deployment.

# Flask
FLASK_ENV=production
FLASK_CONFIG=production
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret
LOG_LEVEL=INFO
NEXUS_RUNTIME_DIR=/tmp/nexus-prime

# Database
# Local SQLite
DATABASE_URL=sqlite:///instance/nexus_prime.db

# Supabase PostgreSQL target
# Prefer Supabase Pooler for serverless-style hosting. Keep sslmode=require.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Local PostgreSQL alternative
# DATABASE_URL=postgresql://username:password@localhost:5432/nexus_prime

# Frontend origins allowed by CORS. Production must not include localhost.
CORS_ORIGINS=https://your-vercel-domain.vercel.app
FRONTEND_ORIGIN=https://your-vercel-domain.vercel.app

# Frontend build/runtime injection used by Vercel and deployment preflight.
# Set this in the Vercel frontend project; Flask does not read it at runtime.
NEXUS_API_BASE_URL=https://your-api-host.example.com/api/v1

# Auth cookies
# Local development can use Secure=false and SameSite=Lax.
# Cross-site Vercel + API deployment requires HTTPS, Secure=true, SameSite=None.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=None
PERMANENT_SESSION_LIFETIME=3600
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# Legacy Flask session cookie defaults, kept for compatibility with extensions.
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=None

# Uploads
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=/tmp/nexus-prime/storage/uploads
UPLOAD_FILES_FOLDER=/tmp/nexus-prime/storage/uploads/files
UPLOAD_AVATARS_FOLDER=/tmp/nexus-prime/storage/uploads/avatars
UPLOAD_LIBRARY_FOLDER=/tmp/nexus-prime/storage/uploads/library

# Cloud storage for avatars and files
# Current implementation supports local storage and Cloudinary.
# Vercel/serverless local disk is temporary. Keep auto so uploads require
# Cloudinary whenever the runtime directory is /tmp or VERCEL=1.
USE_CLOUD_STORAGE=auto
REQUIRE_CLOUD_STORAGE_FOR_UPLOADS=auto
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# AI analysis provider
AI_LOCAL_ANALYSIS=true
# Preferred OpenAI-compatible variables. Use these for OpenAI or an enterprise gateway.
AI_API_KEY=your-openai-compatible-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_SECONDS=20
AI_CONNECT_TIMEOUT_SECONDS=5
AI_DIAGNOSTICS_TIMEOUT_SECONDS=2
AI_DIAGNOSTICS_CACHE_SECONDS=60
# OpenAI-specific aliases are also supported by the backend.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4.1-mini
# Legacy DeepSeek variables remain supported for existing deployments.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Remote demo seed passwords. Required when deploy-supabase-vercel.ps1 seeds Supabase.
NEXUS_DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password
NEXUS_DEMO_USER_PASSWORD=replace-with-demo-user-password

# Optional mail
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password

# Optional cache
# Required for production login rate limiting across Vercel/serverless instances.
CACHE_TYPE=RedisCache
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/0
# UPSTASH_REDIS_URL=rediss://default:<password>@<host>:6379

# Optional error monitoring
SENTRY_DSN=https://your-sentry-dsn
